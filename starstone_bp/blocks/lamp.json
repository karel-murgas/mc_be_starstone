{
    "format_version": "1.21.120",
    "minecraft:block": {
        "description": {
            "identifier": "starstone:lamp",
            "menu_category": {
                "category": "items"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            },
            "states": {
                "starstone:powered": [
                    false,
                    true
                ]
            }
        },
        "components": {
          "minecraft:light_dampening": 0,
            "starstone:surface": {},
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    2,
                    16
                ]
            },
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    2,
                    16
                ]
            },
            "minecraft:map_color": [
                30,
                40,
                60
            ],
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 0.5
            },
            "minecraft:loot": "loot_tables/blocks/lamp.json",
            "minecraft:geometry": {
                "identifier": "geometry.starstone_surface_device"
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "starstone:lamp_off",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": false
                }
            },
            "minecraft:movable": {
                "movement_type": "immovable"
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('minecraft:block_face') == 'up'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'down'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            180,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('starstone:powered') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:lamp_on",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        }
                    },
                    "minecraft:light_emission": 15
                }
            }
        ]
    }
}
