{
    "format_version": "1.21.120",
    "minecraft:block": {
        "description": {
            "identifier": "starstone:conduit",
            "menu_category": {
                "category": "items"
            },
            "states": {
                "starstone:axis": [
                    "x",
                    "y",
                    "z"
                ],
                "starstone:powered": [
                    false,
                    true
                ]
            }
        },
        "components": {
            "starstone:conduit": {},
            "minecraft:map_color": [
