{
    "format_version": "1.21.120",
    "minecraft:block": {
        "description": {
            "identifier": "starstone:bridge",
            "menu_category": {
                "category": "items"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            },
            "states": {
                "starstone:powered_ns": [
                    false,
                    true
                ],
                "starstone:powered_ew": [
                    false,
                    true
                ]
            }
        },
        "components": {
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    3,
                    16
                ]
            },
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    3,
                    16
                ]
            },
            "minecraft:map_color": [
                30,
                40,
                60
            ],
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 0.5
            },
            "minecraft:loot": "loot_tables/blocks/bridge.json",
            "minecraft:geometry": {
                "identifier": "geometry.starstone_bridge"
            },
            "minecraft:material_instances": {
                "body": {
                    "texture": "starstone:casing",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": false
                },
                "lane_ns": {
                    "texture": "starstone:cable_arm_off",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": false
                },
                "lane_ew": {
                    "texture": "starstone:cable_arm_off",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": false
                },
                "*": {
                    "texture": "starstone:casing",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": false
                }
            },
            "starstone:bridge": {},
            "minecraft:movable": {
                "movement_type": "immovable"
            },
            "minecraft:light_emission": 0
        },
        "permutations": [
            {
                "condition": "query.block_state('minecraft:block_face') == 'up'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'down'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            180,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('starstone:powered_ns') == false && query.block_state('starstone:powered_ew') == false",
                "components": {
                    "minecraft:material_instances": {
                        "body": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ns": {
                            "texture": "starstone:cable_arm_off",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ew": {
                            "texture": "starstone:cable_arm_off",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "*": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('starstone:powered_ns') == true && query.block_state('starstone:powered_ew') == false",
                "components": {
                    "minecraft:material_instances": {
                        "body": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ns": {
                            "texture": "starstone:cable_arm_on",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ew": {
                            "texture": "starstone:cable_arm_off",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "*": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('starstone:powered_ns') == false && query.block_state('starstone:powered_ew') == true",
                "components": {
                    "minecraft:material_instances": {
                        "body": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ns": {
                            "texture": "starstone:cable_arm_off",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ew": {
                            "texture": "starstone:cable_arm_on",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "*": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('starstone:powered_ns') == true && query.block_state('starstone:powered_ew') == true",
                "components": {
                    "minecraft:material_instances": {
                        "body": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ns": {
                            "texture": "starstone:cable_arm_on",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "lane_ew": {
                            "texture": "starstone:cable_arm_on",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        },
                        "*": {
                            "texture": "starstone:casing",
                            "render_method": "alpha_test",
                            "face_dimming": false,
                            "ambient_occlusion": false
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('starstone:powered_ns') == true || query.block_state('starstone:powered_ew') == true",
                "components": {
                    "minecraft:light_emission": 1
                }
            }
        ]
    }
}
